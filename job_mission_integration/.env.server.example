# Copy this file to .env.server on the EC2 host.
# Never commit the real .env.server file.

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4-nano
OPENAI_EVAL_MODEL=gpt-4o-mini

ADMIN_PASSWORD=change-this-before-demo
ADMIN_DEMO_UNLOCK=false
COMPATIBILITY_SCORE_GAMMA=1.5

EVALUATE_RATE_LIMIT_WINDOW_MS=60000
EVALUATE_RATE_LIMIT_MAX=10
EVALUATION_LOG_RETENTION_DAYS=14

OPENAI_PREFLIGHT_TIMEOUT_MS=15000

# 채용공고 지도(지금 이 일을 뽑는 곳). 키 값은 여기 말고 EC2의 .env.server에만 넣어.
WORK24_RECRUIT_AUTH_KEY=
KAKAO_REST_API_KEY=
POSTINGS_ENABLED=true
POSTINGS_FIXTURE=0
POSTINGS_DATA_DIR=reports/postings
POSTINGS_REG_DATE=M-1
POSTINGS_MAX_PAGES=10
POSTINGS_REFRESH_HOURS=24

# 실행 환경: development | production (production이면 개발용 로그인·가짜 데이터가 꺼진다)
APP_ENV=production
# 외부에서 접속하는 주소. https로 시작하면 로그인 쿠키에 Secure가 붙는다.
PUBLIC_BASE_URL=http://localhost:8080
# 리버스 프록시(Caddy 등) 뒤에서 돌 때 true
TRUST_PROXY=false
# DB 파일 위치(기본: reports/jobsim.sqlite)
DATABASE_PATH=
# 채점 방식: 비우면 OpenAI 채점, fake면 테스트·시연용 가짜 채점
EVAL_MODE=

# 로그인(카카오 OpenID Connect) — 카카오 개발자 콘솔에서 카카오 로그인·OpenID Connect를 켜고 Redirect URI를 등록해
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
# 비우면 PUBLIC_BASE_URL/auth/kakao/callback
KAKAO_LOGIN_REDIRECT_URI=
# 탈퇴할 때 카카오 연결 끊기에 쓰는 앱 어드민 키(서버에만 둔다)
KAKAO_ADMIN_KEY=
# 개발·테스트용 로그인(운영에서는 자동으로 꺼진다)
AUTH_DEV_LOGIN=false
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# 로그인 전 체험 결과를 서버에 임시로 두는 시간
ANONYMOUS_RESULT_RETENTION_HOURS=24

# HTTPS(docker compose --profile https): 연결한 도메인
JOBSIM_DOMAIN=
