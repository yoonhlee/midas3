# 이 파일을 복사해 .env를 만들어. 실제 키가 들어간 .env는 절대 커밋하지 마.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4-nano
# 미션 생성(Python 명령줄)에 쓸 제공자: anthropic(기본) 또는 openai. 관리자 화면의 생성은 anthropic으로 고정돼 있다.
MISSION_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-opus-5-5
ANTHROPIC_GENERATION_EFFORT=medium
# 거절 때 다른 Claude 모델이 이어받는 설정. 실제 호출에서 이 설정 때문에 400이 나면 false로 끈다.
ANTHROPIC_GENERATION_FALLBACKS=
# 비우면 보통 속도, fast면 빠른 모드. 비용이 2배다.
ANTHROPIC_GENERATION_SPEED=
# OpenAI key는 명령줄 생성기에서 셸 환경 변수나 .env.local에서만 읽는다(.env는 관리자 서버가 읽는다).
OPENAI_EVAL_MODEL=gpt-5-nano
ADMIN_PASSWORD=
ADMIN_DEMO_UNLOCK=false
# 관리자 화면에서 하루에 시작할 수 있는 미션 생성 건수(비우면 20)
ADMIN_GENERATION_DAILY_LIMIT=
# false면 자료 형태를 좁히지 않고 일곱 형태를 다 연다(비우면 좁힘)
ADMIN_GENERATION_NARROW=
# fake면 생성과 검수를 하지 않고 저장소의 고정 결과를 쓴다(시험·화면 테스트용, 운영에서는 켜지지 않는다)
ADMIN_GENERATION_MODE=
# 서버가 띄울 Python. 비우면 python3, Windows는 python
PYTHON_BIN=
COMPATIBILITY_SCORE_GAMMA=1.5
PORT=8080

# 채용공고 지도(지금 이 일을 뽑는 곳)
# 고용24 Open-API "채용정보" 서비스 인증키 (서비스마다 키가 따로 발급돼)
WORK24_RECRUIT_AUTH_KEY=
# 카카오 REST API 키 (카카오 개발자 앱 설정에서 카카오맵 사용 설정을 켜야 해)
KAKAO_REST_API_KEY=
POSTINGS_ENABLED=true
POSTINGS_FIXTURE=0
POSTINGS_DATA_DIR=reports/postings
POSTINGS_REG_DATE=M-1
POSTINGS_MAX_PAGES=10
POSTINGS_REFRESH_HOURS=24
# 공고 요구역량 분석(U25)용 상세 조회 공고 수(직업당). 0이면 제목만 분석
POSTINGS_DETAIL_LIMIT=10

# 실행 환경: development | production (production이면 개발용 로그인·가짜 데이터가 꺼진다)
APP_ENV=development
# 외부에서 접속하는 주소. https로 시작하면 로그인 쿠키에 Secure가 붙는다.
PUBLIC_BASE_URL=http://localhost:8080
# 리버스 프록시(Caddy 등) 뒤에서 돌 때 true
TRUST_PROXY=false
# DB 파일 위치(기본: reports/jobsim.sqlite)
DATABASE_PATH=
# 채점 방식: 비우면 OpenAI 채점, fake면 테스트·시연용 가짜 채점
EVAL_MODE=

# 로그인(카카오 OpenID Connect) — 카카오 개발자 콘솔에서 카카오 로그인·OpenID Connect를 켜고 Redirect URI를 등록해
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
# 비우면 PUBLIC_BASE_URL/auth/kakao/callback
KAKAO_LOGIN_REDIRECT_URI=
# 탈퇴할 때 카카오 연결 끊기에 쓰는 앱 어드민 키(서버에만 둔다)
KAKAO_ADMIN_KEY=
# 개발·테스트용 로그인(운영에서는 자동으로 꺼진다)
AUTH_DEV_LOGIN=false
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# 로그인 전 체험 결과를 서버에 임시로 두는 시간
ANONYMOUS_RESULT_RETENTION_HOURS=24
