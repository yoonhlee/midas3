    "scenario": {
      "role": "당신은 온새미물류 중부센터 네트워크 운영팀의 인턴입니다.",
      "context": "센터 창고에는 온도센서와 출입센서 같은 디바이스, 이 센서들의 데이터를 모아 넘겨 주는 게이트웨이, 데이터를 저장하는 서버가 네트워크로 연결되어 있습니다. 오늘 오전 정기 점검에서 네트워크 매지니먼트시스템(NMS)이 장비별 응답시간을 수집했고, 선배가 그 값을 네트워크 점검 양식에 옮겨 두었습니다. 네트워크 운영팀장님이 “성능관리 차원에서 우리 팀 기준을 못 맞추는 장비가 있는지 확인해 줘요”라고 요청했습니다.",
      "goal": "아래 두 자료를 보고, 성능 요구수준을 만족하지 못하는 장비를 찾아 그 이유를 적어보세요.",
      "constraints": [
        "자료에 적힌 기준과 측정값만 사용하세요.",
        "답변은 2~3문장으로 짧게 작성하세요."
      ],
      "glossary": [
        {
          "term": "네트워크 매지니먼트시스템(NMS)",
          "definition": "네트워크에 연결된 장비의 상태와 응답시간 같은 값을 자동으로 모아 보여 주는 관리 프로그램입니다."
        },
        {
          "term": "성능관리",
          "definition": "네트워크와 장비가 팀이 정해 둔 속도·품질 기준을 잘 지키고 있는지 살피고 문제를 찾는 일입니다."
        },
        {
          "term": "성능 요구수준",
          "definition": "장비가 지켜야 한다고 팀이 정해 둔 성능 기준입니다. 이 미션에서는 응답시간이 넘으면 안 되는 최대값을 말합니다."
        },
        {
          "term": "응답시간",
          "definition": "장비에 신호를 보낸 뒤 대답이 돌아오기까지 걸린 시간입니다. ms(밀리초, 1000분의 1초) 단위로 적으며 숫자가 작을수록 빠릅니다."
        },
        {
          "term": "디바이스",
          "definition": "온도센서나 출입센서처럼 현장에서 값을 재거나 감지하는 말단 장비입니다."
        },
        {
          "term": "게이트웨이",
          "definition": "여러 센서(디바이스)의 데이터를 모아 서버 쪽 네트워크로 넘겨 주는 중계 장비입니다."
        },
        {
          "term": "유무선 TCP/IP",
          "definition": "사내망과 인터넷에서 쓰는 기본 통신 규칙으로, 랜선(유선)이나 무선랜으로 연결된 장비가 이 방식으로 통신합니다."
        },
        {
          "term": "근거리 무선",
          "definition": "가까운 거리에 있는 장비끼리 선 없이 연결하는 통신방식입니다."
        },
        {
          "term": "저전력 광대역",
          "definition": "전기를 아주 적게 쓰면서 넓은 범위에 흩어진 장비를 연결하는 무선 통신방식입니다. 배터리로 오래 버텨야 하는 센서에 주로 씁니다."
        }
      ]
