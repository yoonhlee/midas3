      ],
      "glossary": [
        {
          "term": "단위시험",
          "definition": "장비들을 서로 연결해 함께 시험하기 전에, 장비 하나하나를 따로 시험해 정해진 기준을 넘는지 확인하는 일입니다."
        },
        {
          "term": "단위 시스템",
          "definition": "전체 네트워크를 이루는 장비 하나하나를 말합니다. 단위시험은 이 단위로 따로 진행합니다."
        },
        {
          "term": "인터페이스",
          "definition": "장비에 케이블을 꽂아 다른 장비와 데이터를 주고받는 연결 지점입니다."
        },
        {
          "term": "라우터",
          "definition": "사내 네트워크와 바깥 인터넷처럼 서로 다른 네트워크를 이어 주는 장비입니다."
        },
        {
          "term": "스위치",
          "definition": "사무실 안의 컴퓨터와 장비들을 하나의 네트워크로 묶어 주는 장비입니다."
        },
        {
          "term": "처리량",
          "definition": "연결 지점을 통해 1초 동안 실제로 전달된 데이터의 양입니다. 숫자가 클수록 더 많이 전달한 것입니다."
        },
        {
          "term": "Mbps",
          "definition": "1초에 전달되는 데이터 양을 나타내는 단위(초당 메가비트)입니다."
        },
        {
          "term": "1G 포트",
          "definition": "1초에 최대 1,000Mbps까지 데이터를 주고받도록 만들어진 연결 지점입니다."
        },
        {
          "term": "WAN 인터페이스",
          "definition": "회사 바깥의 넓은 네트워크(인터넷 등)와 연결되는 쪽의 연결 지점입니다."
        }
      ]
